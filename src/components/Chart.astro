---
import {display,source} from '../lib/data';
const {rows,title,caption}=Astro.props;
const valid=rows.filter((r:any)=>r.status==='observed'&&typeof r.value==='number');
const years=rows.map((r:any)=>r.year);const minYear=Math.min(...years);const maxYear=Math.max(...years);const max=rows[0]?.unit==='percent'?100:Math.max(1,...valid.map((r:any)=>r.value))*1.12;
const x=(year:number)=>62+(year-minYear)/Math.max(1,maxYear-minYear)*608;
const y=(value:number)=>245-value/max*205;
const periods=[...new Set(rows.map((r:any)=>r.periodType))].join(', ');
const sources=[...new Set(rows.map((r:any)=>r.sourceId))] as string[];
---
<div class="chart-panel"><h3>{title}</h3><p class="small">{rows[0]?.unit} · {periods} years {minYear}–{maxYear} · Zero baseline</p>
{valid.length?<svg class="chart" viewBox="0 0 720 290" role="img" aria-label={`${title}. ${rows[0]?.unit}. ${valid.map((r:any)=>`${r.year}: ${display(r.value)}`).join('; ')}`}><title>{title}</title><desc>Source-linked data are available in the table immediately below.</desc>{[0,.25,.5,.75,1].map(t=><g><line x1="62" x2="688" y1={y(max*t)} y2={y(max*t)} stroke="#d5dcd3"/><text x="52" y={y(max*t)+4} text-anchor="end">{display(max*t)}</text></g>)}{valid.map((r:any,i:number)=><g>{i>0&&r.year-valid[i-1].year===1&&<line x1={x(valid[i-1].year)} y1={y(valid[i-1].value)} x2={x(r.year)} y2={y(r.value)} stroke="#436f60" stroke-width="3"/>}<circle cx={x(r.year)} cy={y(r.value)} r="5" fill="#436f60"><title>{r.year}: {display(r.value)} {r.unit}</title></circle><text x={x(r.year)} y={y(r.value)-12} text-anchor="middle">{display(r.value)}</text><text x={x(r.year)} y="272" text-anchor="middle">{r.year}</text></g>)}</svg>:<p class="empty">No observed data for this measure. Missing values are not zero.</p>}
<p class="small">{caption||rows[0]?.notes}</p><p class="small">No sampling uncertainty interval is supplied by these administrative records. That does not remove reporting, selection or measurement uncertainty.</p><details><summary>Inspect values, denominators and provenance</summary><div class="table-wrap"><table><thead><tr><th>Year</th><th>Value</th><th>Unit</th><th>Denominator</th><th>Definition / caveat</th><th>Source</th></tr></thead><tbody>{rows.map((r:any)=><tr><td>{r.year} ({r.periodType})</td><td>{r.status==='not applicable'?'Not applicable':r.status==='missing'?'No data':display(r.value)}</td><td>{r.unit}</td><td>{r.denominator===null?'Not supplied / not a rate':display(r.denominator)}</td><td>{r.denominatorDescription}<br/>{r.notes}</td><td><a href={source(r.sourceId)?.url}>{source(r.sourceId)?.publisher}</a><br/>{r.locator}</td></tr>)}</tbody></table></div></details><p class="small">{sources.map(id=><span>Source: <a href={source(id)?.url}>{source(id)?.title}</a>. </span>)}</p></div>
