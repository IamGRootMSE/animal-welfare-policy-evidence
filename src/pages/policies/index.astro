---
import Layout from '../../layouts/Layout.astro';
import { evidence, admins, url } from '../../lib/data';
const areas=[...new Set(evidence.policies.map((p:any)=>p.area))].sort();
const species=[...new Set(evidence.policies.flatMap((p:any)=>p.species))].sort();
const statuses=[...new Set(evidence.policies.map((p:any)=>p.status))].sort();
---
<Layout title="Policy timeline"><div class="eyebrow">Explore the record</div><h1>What changed, and when?</h1><p class="lede">Follow enactment, implementation, court decisions and reversals. An administration filter includes documented contributions after enactment; it is not a count of accomplishments.</p>
<form class="filters" id="policy-filters"><label class="wide">Search policies<input type="search" name="search" placeholder="Try PACT, horse, alternatives…"/></label><label>Administration<select name="administration"><option value="">All administrations</option>{admins.map(a=><option>{a}</option>)}</select></label><label>Policy area<select name="area"><option value="">All areas</option>{areas.map(a=><option>{a}</option>)}</select></label><label>Animal group<select name="species"><option value="">All groups</option>{species.map(a=><option>{a}</option>)}</select></label><label>Evidence available<select name="evidence"><option value="">All evidence</option>{['legal only','implementation','observational','causal'].map(a=><option>{a}</option>)}</select></label><label>Any action year, from<input name="from" type="number" min="1900" max="2026" placeholder="Any year"/></label><label>Any action year, through<input name="to" type="number" min="1900" max="2026" placeholder="2026"/></label><label class="wide">Legal / implementation status<select name="status"><option value="">All statuses</option>{statuses.map(a=><option>{a}</option>)}</select></label><div><button type="reset">Reset filters</button></div></form>
<p class="results" id="result-count" aria-live="polite">{evidence.policies.length} policies in this review</p><p id="no-policies" class="empty" hidden>No policies match these filters. Reset or broaden the selection. This does not mean no policy existed.</p>
<div class="timeline">{evidence.policies.map((p:any)=><article class="policy-card" data-policy data-search={`${p.title} ${p.summary} ${p.changed}`.toLowerCase()} data-admin={JSON.stringify(p.administrations)} data-area={p.area} data-species={JSON.stringify(p.species)} data-evidence={p.outcomeEvidence} data-year={p.date.slice(0,4)} data-history={JSON.stringify(p.history.map((h:any)=>({date:h.date})))} data-status={p.status}><div><span class="date">{p.date}</span><div class="small">Main policy date</div></div><div><div><span class="tag">{p.area}</span><span class="tag muted">{p.outcomeEvidence}</span></div><h3><a href={url(`policies/${p.id}/`)}>{p.title}</a></h3><p>{p.summary}</p><p class="small"><b>Status:</b> {p.status}</p><details><summary>View status changes ({p.history.length})</summary><ol class="history">{p.history.map((h:any)=><li><time>{h.date}</time> <span class="tag">{h.status}</span><p>{h.event}</p></li>)}</ol><a href={url(`policies/${p.id}/#sources`)}>Inspect supporting sources</a></details></div></article>)}</div>
<script>import {matchesPolicy} from '../../lib/filters';const form=document.querySelector<HTMLFormElement>('#policy-filters')!;function filter(){const f=Object.fromEntries(new FormData(form)) as Record<string,string>;let n=0;document.querySelectorAll<HTMLElement>('[data-policy]').forEach(el=>{const d=el.dataset;const show=matchesPolicy({title:d.search!,summary:'',changed:'',administrations:JSON.parse(d.admin!),area:d.area!,species:JSON.parse(d.species!),outcomeEvidence:d.evidence!,date:d.year!,status:d.status!,history:JSON.parse(d.history!)},f);el.hidden=!show;if(show)n++});document.querySelector('#result-count')!.textContent=`${n} policies match your filters`;document.querySelector<HTMLElement>('#no-policies')!.hidden=n>0}form.addEventListener('input',filter);form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>setTimeout(filter,0));</script></Layout>
