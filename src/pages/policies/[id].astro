---
import Layout from '../../layouts/Layout.astro';
import {evidence,source,url} from '../../lib/data';
export function getStaticPaths(){return evidence.policies.map((p:any)=>({params:{id:p.id},props:{p}}))}
const {p}=Astro.props;const claims=evidence.claims.filter((c:any)=>c.policyId===p.id);const cases=evidence.cases.filter((c:any)=>c.policyId===p.id);
const blocks=[['What changed?',p.changed],['What happened afterward?',p.afterward],['What can we attribute to the policy?',p.attribution],['What remains unknown?',p.unknown],['How could this help animals?',p.mechanism]];
---
<Layout title={p.title}><a href={url('policies/')}>← Policy timeline</a><div class="hero"><span class="tag">{p.area}</span><span class="tag muted">{p.outcomeEvidence} evidence</span><h1>{p.title}</h1><p class="lede">{p.summary}</p><div class="notice"><strong>Legal / implementation status:</strong> {p.status}</div></div><div class="detail-grid"><div>{blocks.map(([title,text])=><section class="detail-block"><h2>{title}</h2><p>{text}</p></section>)}<section class="detail-block"><h2>Who contributed?</h2>{p.contributors.map((c:any)=><p><strong>{c.institution}.</strong> {c.role}</p>)}</section></div><aside class="aside"><h2>Scope & confidence</h2><p><b>Groups:</b> {p.species.join(', ')}</p><p><b>Coverage:</b> {p.coverage}</p><p><b>Exceptions:</b> {p.exceptions}</p><p><b>Confidence in the stated finding:</b> {p.confidence}</p><p>{p.confidenceReason}</p><a href={url('methods/#confidence')}>How confidence is assessed</a><div class="divider"></div><p class="small">Legal certainty does not establish effectiveness. Low confidence does not mean low impact.</p></aside></div>
<section class="section"><h2>Legal and implementation history</h2><ol class="history">{p.history.map((h:any)=><li><time>{h.date}</time> <span class="tag">{h.status}</span><p>{h.event}</p><div class="small">{h.sourceIds?.map((id:string)=><a href={source(id)?.url}>{source(id)?.title} </a>)}</div></li>)}</ol></section>
{cases.length>0&&<section class="section"><h2>Selected enforcement records</h2><p>These records illustrate implementation. They are not a complete census and must not be summed into a national prosecution or animal-rescue total.</p><div class="grid two">{cases.map((c:any)=><article class="card"><span class="tag">{c.recordUnit}</span><h3>{c.caseName}</h3><p class="small">{c.date} · {c.court}<br/>Docket: {c.docket||'Not recorded'}</p><p><b>Provision:</b> {c.statute}</p><p><b>Disposition:</b> {c.disposition}</p><p><b>Penalty:</b> {c.penalty}</p><p><b>Animal follow-up:</b> {c.followup}</p><p class="small">{c.limitations}</p>{c.sourceIds.map((id:string)=><p class="small"><a href={source(id)?.url}>{source(id)?.title}</a></p>)}</article>)}</div></section>}
<section class="section"><h2>Claim-to-source ledger</h2><p>Each confidence label applies to the particular claim below.</p>{claims.map((c:any)=><details><summary>{c.claim}</summary><p><b>{c.confidence} confidence · {c.evidenceType}</b></p><p>{c.limitations}</p><p class="small">Locator: {c.locator} · Independently verified: {c.independentlyVerified?'Yes':'No independent replication / verification recorded'}</p><ul>{c.sourceIds.map((id:string)=><li><a href={source(id)?.url}>{source(id)?.title}</a></li>)}</ul></details>)}</section>
<section id="sources" class="section"><h2>Sources for this policy</h2><ol class="source-list">{p.sourceIds.map((id:string)=>{const s=source(id);return s&&<li><a href={s.url}>{s.title}</a><div class="small">{s.publisher} · Published {s.publicationDate||'date not identified'} · Accessed {s.accessDate}<br/>{s.locator}<br/>{s.limitations}</div></li>})}</ol></section></Layout>
